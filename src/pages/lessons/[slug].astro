---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MermaidDiagram from '../../components/MermaidDiagram.astro';
import { sitePath } from '../../lib/site-path';

export async function getStaticPaths() {
	const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
	return lessons.map((lesson, index) => ({
		params: { slug: lesson.id },
		props: { lesson, prev: lessons[index - 1], next: lessons[index + 1] },
	}));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const kicker = lesson.data.stage
	? `Lesson ${lesson.data.order} · ${lesson.data.stage}`
	: `Lesson ${lesson.data.order}`;
---

<Base title={`${lesson.data.title} — Worker pool`} description={lesson.data.description} layout="lesson">
	<article class="lesson">
		<p class="lesson-kicker">{kicker}</p>
		<h1>{lesson.data.title}</h1>
		<p class="lesson-lead">{lesson.data.description}</p>
		<div class="prose" data-lesson-prose>
			<Content />
		</div>
		<div hidden data-mermaid-stash>
			<div data-mermaid-tpl="pipeline">
				<MermaidDiagram id="pipeline" />
			</div>
			<div data-mermaid-tpl="states">
				<MermaidDiagram id="states" />
			</div>
			<div data-mermaid-tpl="resilience">
				<MermaidDiagram id="resilience" />
			</div>
		</div>
		<nav class="lesson-pager" aria-label="Lessons">
			{
				prev ? (
					<a href={sitePath(`lessons/${prev.id}/`)}>
						<small>Previous</small>
						<strong>{prev.data.title}</strong>
					</a>
				) : (
					<a href={sitePath()}>
						<small>Back to</small>
						<strong>Overview</strong>
					</a>
				)
			}
			{
				next && (
					<a class="pager-next" href={sitePath(`lessons/${next.id}/`)}>
						<small>Next</small>
						<strong>{next.data.title}</strong>
					</a>
				)
			}
		</nav>
	</article>
</Base>
