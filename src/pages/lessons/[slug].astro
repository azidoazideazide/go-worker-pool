---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PipelineDiagram from '../../components/diagrams/PipelineDiagram.astro';
import StatesDiagram from '../../components/diagrams/StatesDiagram.astro';
import ResilienceDiagram from '../../components/diagrams/ResilienceDiagram.astro';
import { sitePath } from '../../lib/site-path';

export async function getStaticPaths() {
	const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
	return lessons.map((lesson, index) => ({
		params: { slug: lesson.id },
		props: { lesson, prev: lessons[index - 1], next: lessons[index + 1] },
	}));
}

const { lesson, prev, next } = Astro.props;
// Lessons mark a diagram with an HTML comment such as `<!-- diagram: pipeline -->`.
// The page splits the rendered lesson at each marker and places the static
// diagram there at build time, so no script runs and nothing flashes.
const diagrams = { pipeline: PipelineDiagram, states: StatesDiagram, resilience: ResilienceDiagram } as const;
type DiagramId = keyof typeof diagrams;
const html = lesson.rendered?.html ?? '';
const parts = html.split(/<!--\s*diagram:\s*(\w+)\s*-->/);
const pieces: Array<{ html: string } | { diagram: DiagramId }> = parts.map((part, index) =>
	index % 2 === 1 && part in diagrams ? { diagram: part as DiagramId } : { html: index % 2 === 1 ? '' : part },
);
const kicker = lesson.data.stage
	? `Lesson ${lesson.data.order} · ${lesson.data.stage}`
	: `Lesson ${lesson.data.order}`;
---

<Base title={`${lesson.data.title} — Worker pool`} description={lesson.data.description} layout="lesson">
	<article class="lesson">
		<p class="lesson-kicker">{kicker}</p>
		<h1>{lesson.data.title}</h1>
		<p class="lesson-lead">{lesson.data.description}</p>
		<div class="prose">
			{
				pieces.map((piece) => {
					if ('diagram' in piece) {
						const Figure = diagrams[piece.diagram];
						return <Figure />;
					}
					return <Fragment set:html={piece.html} />;
				})
			}
		</div>
		<nav class="lesson-pager" aria-label="Lessons">
			{
				prev ? (
					<a href={sitePath(`lessons/${prev.id}/`)}>
						<small>Previous</small>
						<strong>{prev.data.title}</strong>
					</a>
				) : (
					<a href={sitePath()}>
						<small>Back to</small>
						<strong>Overview</strong>
					</a>
				)
			}
			{
				next && (
					<a class="pager-next" href={sitePath(`lessons/${next.id}/`)}>
						<small>Next</small>
						<strong>{next.data.title}</strong>
					</a>
				)
			}
		</nav>
	</article>
</Base>
