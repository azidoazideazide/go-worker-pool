---
/**
 * HomeTutorial — architectural overview and guide below PoolPicture on the Home page.
 *
 * Uses hairline ledger rows and one static comparison diagram rather than nested
 * rounded cards. Data arrays stay at the top so layout changes remain easy.
 */
import ComparisonDiagram from './diagrams/ComparisonDiagram.astro';
import { sitePath } from '../lib/site-path';
import { POOL_PRESETS, type PresetKey } from '../lib/pool-presets';

const zones = [
	{
		num: '01',
		title: 'Producer',
		code: 'jobs <- job',
		desc: 'Makes jobs and sends them into the channel. When every worker is Busy and the buffer is full, the producer waits at the outlet (Blocked).',
	},
	{
		num: '02',
		title: 'Channel',
		code: 'jobs := make(chan Job, N)',
		desc: 'Holds up to N waiting jobs, first in, first out. Slot [0] is the front. When a worker is Idle, a send goes straight to it and skips the buffer (handoff).',
	},
	{
		num: '03',
		title: 'Workers',
		code: 'for job := range jobs',
		desc: 'A fixed team of 1 to 6 goroutines. Each gopher runs one job at a time. Its pill shows its state: Idle, Busy, Alert, Draining, or Offline.',
	},
	{
		num: '04',
		title: 'Results',
		code: 'results <- Result{}',
		desc: 'Each job ends as one result: Done or Failed. In Resilience mode, a failed attempt waits in Retry backoff (zone 01). After 3 attempts the job goes to Failed.',
	},
] as const;

const workloads = [
	{
		tag: 'EMAIL',
		tone: 'email',
		kind: 'I/O-bound network work (1s–2s)',
		desc: 'Workers wait on a mail server. A few in parallel send more mail without hitting the rate limit.',
	},
	{
		tag: 'WEBHOOK',
		tone: 'webhook',
		kind: 'I/O-bound HTTP calls (1s–3s)',
		desc: 'Customer servers can hang or return HTTP 503. Each attempt needs a deadline and a retry backoff.',
	},
	{
		tag: 'IMG',
		tone: 'image',
		kind: 'CPU-bound image work (3s–5s)',
		desc: 'Resizing uses a lot of CPU and memory. A worker count near the CPU core count keeps large uploads from starving the server.',
	},
	{
		tag: 'SYNC',
		tone: 'sync',
		kind: 'Connection-limited DB work (2s–4s)',
		desc: 'A database allows only a few open connections. One worker per connection never goes over that limit.',
	},
] as const;

const watch: Record<PresetKey, string> = {
	steady: 'Each new job goes straight to an Idle worker. The buffer stays almost empty.',
	backpressure: 'All 4 slots fill, FULL appears, and the producer becomes Blocked.',
	timeouts: 'Slow attempts hit the 4s deadline, flash Alert, wait in Retry backoff, and run again.',
	drain: 'The producer stops. Workers take Slot [0] until the buffer is empty, then park as Idle.',
};

const extra: Partial<Record<PresetKey, string>> = { timeouts: ' · Resilience', drain: ' · producer off' };

const presets = (Object.keys(watch) as PresetKey[]).map((key) => {
	const preset = POOL_PRESETS[key];
	return {
		key,
		num: preset.order,
		title: preset.label,
		spec: `${preset.workers} workers · buffer ${preset.capacity}${extra[key] ?? ''}`,
		desc: watch[key],
	};
});

const lessonGroups = [
	{
		audience: 'For everyone',
		note: 'No Go needed.',
		items: [
			{
				title: 'Concepts',
				href: sitePath('lessons/design/'),
				desc: 'The four zones, the channel rules, backpressure, and the worker states.',
			},
			{
				title: 'Resilience',
				href: sitePath('lessons/resilience/'),
				desc: 'Deadlines, retries with backoff and jitter, the dead-letter queue, and common pitfalls.',
			},
		],
	},
	{
		audience: 'For engineers',
		note: 'Go code.',
		items: [
			{
				title: 'Go Syntax',
				href: sitePath('lessons/syntax/'),
				desc: 'go, make(chan T, N), send and receive, range and close, sync.WaitGroup, and select.',
			},
			{
				title: 'Build It',
				href: sitePath('lessons/setup/'),
				desc: 'A 5-step plan to write, stop cleanly, and race-test the Go module in processor/.',
			},
		],
	},
] as const;
---

<div class="home-tutorial" data-home-tutorial>
	<section class="guide-block" id="why" data-tutorial-section="why" aria-labelledby="guide-why-title">
		<div class="guide-intro">
			<h2 class="guide-heading" id="guide-why-title">What is a worker pool?</h2>
			<p class="guide-lead">
				Apps run background jobs: they send emails, call webhooks, resize images, and sync database records.
				A <strong>worker pool</strong> runs these jobs with a fixed number of workers. Extra jobs wait in a buffer. When the
				buffer is full, the sender waits too. The picture above shows this pool at work.
			</p>
		</div>
		<ComparisonDiagram />
	</section>

	<section class="guide-block guide-two-col" data-tutorial-section="zones" aria-labelledby="guide-zones-title">
		<div class="guide-col">
			<h2 class="guide-heading" id="guide-zones-title">The four zones in the picture</h2>
			<p class="guide-sub">
				Read the stage above from left to right. Each numbered zone maps to one part of the Go program.
			</p>
			<dl class="guide-ledger">
				{
					zones.map((z) => (
						<div class="guide-ledger-row">
							<dt class="guide-ledger-term">
								<span class="guide-num">{z.num}</span>
								<strong>{z.title}</strong>
								<code>{z.code}</code>
							</dt>
							<dd class="guide-ledger-desc">{z.desc}</dd>
						</div>
					))
				}
			</dl>
		</div>

		<div class="guide-col">
			<h2 class="guide-heading">The four job types</h2>
			<p class="guide-sub">
				Each moving packet represents one of four real background workloads with its own work time and failure mode.
			</p>
			<dl class="guide-ledger">
				{
					workloads.map((w) => (
						<div class="guide-ledger-row">
							<dt class="guide-ledger-term">
								<span class={`guide-job-tag guide-job-${w.tone}`}>{w.tag}</span>
								<strong>{w.kind}</strong>
							</dt>
							<dd class="guide-ledger-desc">{w.desc}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="guide-block guide-two-col" data-tutorial-section="next" aria-label="Try and read">
		<div class="guide-col">
			<h2 class="guide-heading" id="guide-try-title">Try a preset</h2>
			<p class="guide-sub">Each row loads a starting state into the picture and scrolls up to it.</p>
			<ul class="guide-ledger guide-actions" aria-labelledby="guide-try-title">
				{
					presets.map((p) => (
						<li>
							<button type="button" class="guide-action" data-try-preset={p.key}>
								<span class="guide-ledger-term">
									<span class="guide-num">{p.num}</span>
									<strong>{p.title}</strong>
									<code>{p.spec}</code>
								</span>
								<span class="guide-ledger-desc">{p.desc}</span>
							</button>
						</li>
					))
				}
			</ul>
		</div>

		<div class="guide-col">
			<h2 class="guide-heading" id="guide-lessons-title">Read the lessons</h2>
			<p class="guide-sub">Start with the first two. The last two show the Go code.</p>
			<nav class="guide-ledger guide-actions" aria-labelledby="guide-lessons-title">
				{
					lessonGroups.map((group) => (
						<div class="guide-group">
							<p class="guide-group-head">
								<strong>{group.audience}</strong> {group.note}
							</p>
							{group.items.map((l) => (
								<a class="guide-action" href={l.href}>
									<span class="guide-ledger-term">
										<strong>{l.title}</strong>
										<span class="guide-go" aria-hidden="true">
											→
										</span>
									</span>
									<span class="guide-ledger-desc">{l.desc}</span>
								</a>
							))}
						</div>
					))
				}
			</nav>
		</div>
	</section>
</div>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-try-preset]');
	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const key = btn.getAttribute('data-try-preset');
			if (!key) return;
			const radio = document.querySelector<HTMLInputElement>(`input[name="pool-preset"][value="${key}"]`);
			if (radio) {
				radio.checked = true;
				radio.dispatchEvent(new Event('change', { bubbles: true }));
			}
			const stage = document.getElementById('pool-title');
			const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			stage?.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
		});
	});
</script>
