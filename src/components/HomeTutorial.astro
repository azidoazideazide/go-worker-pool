---
/**
 * HomeTutorial — architectural overview and guide below PoolPicture on the Home page.
 *
 * Uses hairline ledger rows and a real rendered Mermaid diagram rather than nested
 * rounded cards. Data arrays stay at the top so layout changes remain easy.
 */
import MermaidDiagram from './MermaidDiagram.astro';
import { sitePath } from '../lib/site-path';
import type { PresetKey } from '../lib/pool-presets';

const approaches = [
	{
		name: 'Sequential (one by one)',
		code: 'for _, job := range jobs { process(job) }',
		burst: '1 worker runs 1 job at a time; 999 jobs wait in a single line.',
		resources: 'Flat memory, poor throughput',
	},
	{
		name: 'Unbounded (all at once)',
		code: 'for _, job := range jobs { go process(job) }',
		burst: '1,000 goroutines start at once and compete for CPU and sockets.',
		resources: 'Memory spike, database connection exhaustion',
	},
	{
		name: 'Worker pool (bounded)',
		code: 'jobs := make(chan Job, 6) // + 3 workers',
		burst: '3 workers run in parallel, 6 slots buffer bursts, sender waits when full.',
		resources: 'Fast throughput, fixed memory ceiling',
	},
] as const;

const zones = [
	{
		num: '01',
		title: 'Producer',
		code: 'jobs <- job',
		desc: 'Creates job packets and sends them into the channel. When all workers are busy and all buffer slots are full, the producer waits at the outlet (Blocked).',
	},
	{
		num: '02',
		title: 'Channel & Buffer',
		code: 'jobs := make(chan Job, N)',
		desc: 'A first-in, first-out conveyor belt with N waiting slots. Slot [0] is the front. If a worker is already Idle, a send skips the buffer completely (Handoff).',
	},
	{
		num: '03',
		title: 'Workers',
		code: 'for job := range jobs',
		desc: 'A fixed team of 1 to 6 goroutines. Each gopher takes one job at a time and shows its state: Idle, Busy, Alert, Draining, or Offline.',
	},
	{
		num: '04',
		title: 'Results',
		code: 'results <- Result{}',
		desc: 'Every completed job sends one Result to the Done tray. In Resilience mode, failed attempts wait in Retry backoff and move to Failed after 3 attempts.',
	},
] as const;

const workloads = [
	{
		tag: 'EMAIL',
		tone: 'email',
		kind: 'I/O-bound network work (1s–2s)',
		desc: 'Workers wait on an external SMTP server. Running a few in parallel increases throughput without hitting rate limits.',
	},
	{
		tag: 'WEBHOOK',
		tone: 'webhook',
		kind: 'I/O-bound HTTP calls (1s–3s)',
		desc: 'Customer endpoints can hang or return HTTP 503. Needs a per-attempt context deadline and retry backoff.',
	},
	{
		tag: 'IMG',
		tone: 'image',
		kind: 'CPU-bound image work (3s–5s)',
		desc: 'Resizing images uses heavy CPU and RAM. Bounding the worker count prevents large uploads from starving the server.',
	},
	{
		tag: 'SYNC',
		tone: 'sync',
		kind: 'Connection-limited DB work (2s–4s)',
		desc: 'Databases allow only a small pool of active connections. A fixed worker count respects that limit.',
	},
] as const;

const presets: ReadonlyArray<{
	key: PresetKey;
	num: number;
	title: string;
	desc: string;
}> = [
	{
		key: 'steady',
		num: 1,
		title: 'Steady flow',
		desc: 'Three workers keep up with the producer. Watch jobs hand off directly to idle workers without waiting in the buffer.',
	},
	{
		key: 'backpressure',
		num: 2,
		title: 'Backpressure',
		desc: 'Two workers are slower than the producer. All 6 slots fill, the FULL badge appears, and the producer blocks on send.',
	},
	{
		key: 'timeouts',
		num: 3,
		title: 'Timeout & retry',
		desc: 'Resilience mode. Slow attempts hit the 4s context deadline, flash Alert, wait in Retry backoff with jitter, and retry.',
	},
	{
		key: 'drain',
		num: 4,
		title: 'Drain & idle',
		desc: 'Auto-send is off. Workers empty the remaining buffer from Slot [0] one by one, then park on <-jobs in Idle state.',
	},
];

const lessons = [
	{
		num: 'Lesson 1',
		stage: 'System Design',
		title: 'Concepts',
		href: sitePath('lessons/design/'),
		desc: 'How the 4 zones, channel buffer rules, handoff, backpressure, and worker states work.',
	},
	{
		num: 'Lesson 2',
		stage: 'System Design',
		title: 'Resilience',
		href: sitePath('lessons/resilience/'),
		desc: 'Context deadlines, transient errors, retry backoff with jitter, dead-letter queues, and 6 common pitfalls.',
	},
	{
		num: 'Lesson 3',
		stage: 'Go Concurrency',
		title: 'Go Syntax',
		href: sitePath('lessons/syntax/'),
		desc: 'Goroutines, buffered channels, directional types, range and close, sync.WaitGroup, and select.',
	},
	{
		num: 'Lesson 4',
		stage: 'Go Implementation',
		title: 'Build It',
		href: sitePath('lessons/setup/'),
		desc: 'A 5-step blueprint to write, shut down cleanly, and race-test the companion Go module in processor/.',
	},
] as const;
---

<div class="home-tutorial" data-home-tutorial>
	<section class="guide-block" data-tutorial-section="why" aria-labelledby="guide-why-title">
		<div class="guide-intro">
			<h2 class="guide-heading" id="guide-why-title">Why use a worker pool?</h2>
			<p class="guide-lead">
				Applications constantly run background jobs such as sending emails, delivering webhooks, resizing images,
				and syncing database records. A <strong>worker pool</strong> runs a fixed number of workers pulling from one
				buffered channel so bursts wait in line instead of crashing the server.
			</p>
		</div>

		<div class="guide-table-wrap">
			<table class="guide-table">
				<thead>
					<tr>
						<th scope="col">Approach</th>
						<th scope="col">Go pattern</th>
						<th scope="col">When 1,000 jobs arrive at once</th>
						<th scope="col">Resource profile</th>
					</tr>
				</thead>
				<tbody>
					{
						approaches.map((row) => (
							<tr>
								<th scope="row">{row.name}</th>
								<td>
									<code>{row.code}</code>
								</td>
								<td>{row.burst}</td>
								<td>{row.resources}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<MermaidDiagram id="comparison" />
	</section>

	<section class="guide-block guide-two-col" data-tutorial-section="zones" aria-labelledby="guide-zones-title">
		<div class="guide-col">
			<h2 class="guide-heading" id="guide-zones-title">The four zones in the picture</h2>
			<p class="guide-sub">
				Read the stage above from left to right. Each numbered zone maps to one part of the Go program.
			</p>
			<dl class="guide-ledger">
				{
					zones.map((z) => (
						<div class="guide-ledger-row">
							<dt class="guide-ledger-term">
								<span class="guide-num">{z.num}</span>
								<strong>{z.title}</strong>
								<code>{z.code}</code>
							</dt>
							<dd class="guide-ledger-desc">{z.desc}</dd>
						</div>
					))
				}
			</dl>
		</div>

		<div class="guide-col">
			<h2 class="guide-heading">The four job types</h2>
			<p class="guide-sub">
				Each moving packet represents one of four real background workloads with its own work time and failure mode.
			</p>
			<dl class="guide-ledger">
				{
					workloads.map((w) => (
						<div class="guide-ledger-row">
							<dt class="guide-ledger-term">
								<span class={`guide-job-tag guide-job-${w.tone}`}>{w.tag}</span>
								<strong>{w.kind}</strong>
							</dt>
							<dd class="guide-ledger-desc">{w.desc}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="guide-block" data-tutorial-section="try" aria-labelledby="guide-try-title">
		<div class="guide-intro">
			<h2 class="guide-heading" id="guide-try-title">Four presets to test in the picture</h2>
			<p class="guide-sub">
				Select any preset below to load that starting state into the stage at the top of the page.
			</p>
		</div>

		<div class="guide-strip">
			{
				presets.map((p) => (
					<div class="guide-strip-cell">
						<div class="guide-cell-head">
							<span class="guide-num">{p.num}</span>
							<strong class="guide-cell-title">{p.title}</strong>
						</div>
						<p class="guide-cell-desc">{p.desc}</p>
						<button type="button" class="btn guide-load-btn" data-try-preset={p.key}>
							Load preset {p.num}
						</button>
					</div>
				))
			}
		</div>
	</section>

	<section class="guide-block" data-tutorial-section="lessons" aria-labelledby="guide-lessons-title">
		<div class="guide-intro">
			<h2 class="guide-heading" id="guide-lessons-title">Lessons: from system design to Go code</h2>
			<p class="guide-sub">
				Lessons 1 and 2 explain the architecture and failure handling for everyone. Lessons 3 and 4 cover Go
				concurrency syntax and building the companion module in <code>processor/</code>.
			</p>
		</div>

		<nav class="guide-strip" aria-label="Course lessons">
			{
				lessons.map((l) => (
					<a class="guide-strip-cell guide-lesson-cell" href={l.href}>
						<div class="guide-lesson-meta">
							<span>{l.num}</span>
							<span>{l.stage}</span>
						</div>
						<strong class="guide-cell-title">{l.title}</strong>
						<p class="guide-cell-desc">{l.desc}</p>
					</a>
				))
			}
		</nav>
	</section>
</div>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-try-preset]');
	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const key = btn.getAttribute('data-try-preset');
			if (!key) return;
			const radio = document.querySelector<HTMLInputElement>(`input[name="pool-preset"][value="${key}"]`);
			if (radio) {
				radio.checked = true;
				radio.dispatchEvent(new Event('change', { bubbles: true }));
			}
			const stage = document.getElementById('pool-title');
			stage?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>
