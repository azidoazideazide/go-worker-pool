---
/**
 * PoolPicture — the interactive picture of one Go worker pool.
 *
 * Producer ──jobs <- job──▶ Channel (chan Job, buffer) ──<-jobs──▶ Workers (goroutines) ──▶ Results
 *                                     ▲                                  │
 *                                     └──────── Retry backoff ◀──────────┘ (Resilience mode)
 *
 * The model lives in src/lib/pool-engine.ts (pure, no DOM). This component draws
 * the state and moves job packets between docks. The DOM is a lagging view of the state:
 * each change is measured (First), applied, measured again (Last), then animated.
 */
import {
	DEFAULT_PRESET,
	JOB_TYPES,
	JOB_TYPE_ORDER,
	MAX_BUFFER,
	MAX_WORKERS,
	POOL_PRESETS,
	PRESET_ORDER,
} from '../lib/pool-presets';

const initial = POOL_PRESETS[DEFAULT_PRESET];
const slotIndexes = Array.from({ length: MAX_BUFFER }, (_, i) => MAX_BUFFER - 1 - i); // [5..0], front at the right
const workerIds = Array.from({ length: MAX_WORKERS }, (_, i) => i + 1);
const presets = PRESET_ORDER.map((key) => POOL_PRESETS[key]);

const presetMeta = (key: (typeof PRESET_ORDER)[number]) => {
	const p = POOL_PRESETS[key];
	const parts = [`${p.workers} workers`, `cap ${p.capacity}`];
	if (p.mode === 'resilience') parts.push(`ctx ${p.timeoutSec}s`);
	if (!p.autoSend) parts.push('producer off');
	return parts.join(' · ');
};
---

<section class="pool" data-pool data-mode={initial.mode} data-running="false" aria-labelledby="pool-title">
	<svg width="0" height="0" class="sr-only" aria-hidden="true" focusable="false">
		<symbol id="pool-icon-email" viewBox="0 0 16 16">
			<rect x="2" y="3.5" width="12" height="9" rx="1.5"></rect>
			<path d="M2.6 4.6 8 8.8l5.4-4.2"></path>
		</symbol>
		<symbol id="pool-icon-webhook" viewBox="0 0 16 16">
			<path d="M9.2 1.8 3.6 9h4.1l-1 5.2L12.4 7H8.3z"></path>
		</symbol>
		<symbol id="pool-icon-image" viewBox="0 0 16 16">
			<rect x="2" y="2.5" width="12" height="11" rx="1.5"></rect>
			<circle cx="6" cy="6.3" r="1.3"></circle>
			<path d="m2.6 12 3.6-3.6 2.6 2.6 1.7-1.7 2.9 2.9"></path>
		</symbol>
		<symbol id="pool-icon-sync" viewBox="0 0 16 16">
			<path d="M12.8 6.4A5 5 0 0 0 3.9 4.6L2.8 5.9"></path>
			<path d="M2.8 2.8v3.1h3.1"></path>
			<path d="M3.2 9.6a5 5 0 0 0 8.9 1.8l1.1-1.3"></path>
			<path d="M13.2 13.2v-3.1h-3.1"></path>
		</symbol>
		<symbol id="pool-icon-check" viewBox="0 0 16 16"><path d="m3.5 8.4 3 3 6-6.8"></path></symbol>
		<symbol id="pool-icon-cross" viewBox="0 0 16 16"><path d="m4.5 4.5 7 7m0-7-7 7"></path></symbol>
		<symbol id="pool-icon-arrow" viewBox="0 0 16 16"><path d="M3 8h9.5M8.8 4.2 12.6 8l-3.8 3.8"></path></symbol>
		<symbol id="pool-icon-send" viewBox="0 0 16 16"><path d="M8 13V3.5M4.2 7.2 8 3.4l3.8 3.8"></path></symbol>
		<symbol id="pool-icon-play" viewBox="0 0 16 16"><path d="M5 3.2v9.6L12.6 8z"></path></symbol>
		<symbol id="pool-icon-pause" viewBox="0 0 16 16"><path d="M5.5 3.5v9M10.5 3.5v9"></path></symbol>
		<symbol id="pool-icon-step" viewBox="0 0 16 16"><path d="M4 3.5 9.5 8 4 12.5zM12 3.5v9"></path></symbol>
		<symbol id="pool-icon-reset" viewBox="0 0 16 16">
			<path d="M3 8a5 5 0 1 0 1.6-3.7"></path>
			<path d="M3 2.6v3h3"></path>
		</symbol>
		<symbol id="pool-icon-retry" viewBox="0 0 16 16">
			<path d="M13 8a5 5 0 1 1-1.6-3.7"></path>
			<path d="M13 2.6v3h-3"></path>
		</symbol>
		<symbol id="pool-icon-clock" viewBox="0 0 16 16">
			<circle cx="8" cy="8" r="5.5"></circle>
			<path d="M8 5v3.2l2 1.3"></path>
		</symbol>
	</svg>

	<div class="pool-layout">
		<div class="stage-frame">
			<header class="stage-head">
				<div class="stage-title">
					<h1 id="pool-title">Worker pool</h1>
					<span class="run-chip" aria-hidden="true"><span class="run-dot"></span><span data-run-label>Paused</span></span>
					<a class="stage-intro" href="#why">What is a worker pool?</a>
				</div>
				<fieldset class="mode-switch">
					<legend class="sr-only">Mode</legend>
					<label>
						<input type="radio" name="pool-mode" value="core" checked={initial.mode === 'core'} />
