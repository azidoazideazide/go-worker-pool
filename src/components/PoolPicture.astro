					</label>
					<label>
						<input type="radio" name="pool-mode" value="resilience" checked={initial.mode === 'resilience'} />
						<svg class="icon" aria-hidden="true"><use href="#pool-icon-clock"></use></svg>
						Resilience
					</label>
				</fieldset>
				<p class="stage-hint" data-hint>{initial.hint}</p>
			</header>

			<div class="stage" data-stage>
				<section class="zone zone-producer" aria-labelledby="zone-producer-title">
					<div class="zone-head">
						<span class="zone-num" aria-hidden="true">01</span>
						<h2 class="zone-title" id="zone-producer-title">Producer</h2>
