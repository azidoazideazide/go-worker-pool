---
interface Props {
	id: 'comparison' | 'pipeline' | 'states' | 'resilience';
	title?: string;
	caption?: string;
}

const { id, title, caption } = Astro.props;

const diagrams: Record<
	Props['id'],
	{
		defaultTitle: string;
		defaultCaption: string;
		code: string;
	}
> = {
	comparison: {
		defaultTitle: 'Sequential vs. Unbounded vs. Worker pool',
		defaultCaption:
			'Sequential execution queues 99 jobs behind 1 worker. Unbounded execution spawns 1,000 goroutines at once and exhausts resources. A worker pool bounds active workers and holds bursts in a fixed channel buffer.',
		code: `flowchart TB
    subgraph S1["1. Sequential (One by One)"]
        direction LR
        A1["100 Jobs arrive"] --> A2["1 Worker<br/>1 job at a time"] --> A3["99 jobs wait<br/>Slow batch time"]
    end

    subgraph S2["2. Unbounded (All at Once)"]
        direction LR
        B1["1,000 Jobs arrive"] --> B2["1,000 Goroutines<br/>spawned at once"] --> B3["RAM & DB spike<br/>System overload"]
    end

    subgraph S3["3. Worker Pool (Bounded)"]
        direction LR
        C1["01 Producer<br/>jobs &lt;- job"] --> C2["02 Channel Buffer<br/>6 FIFO slots"] --> C3["03 Workers (3)<br/>Fixed goroutines"] --> C4["04 Results<br/>Steady flow"]
    end

    S1 ~~~ S2 ~~~ S3`,
	},
	pipeline: {
		defaultTitle: 'How a job moves from producer to result',
		defaultCaption:
			'An idle worker receives a send directly (handoff). When all workers are busy, jobs wait in the buffer from tail to front (Slot [0]). When the buffer is full, the producer blocks.',
		code: `flowchart TB
    P["01 Producer<br/>jobs &lt;- job"]

    subgraph Chan["02 Channel Buffer (make(chan Job, N))"]
        direction LR
        Tail["Slot [N-1] (Tail)"] --> Mid["..."] --> Front["Slot [0] (Front)"]
    end

    subgraph Pool["03 Worker Pool (Fixed Goroutines)"]
        direction LR
        W1["Worker 1"]
        W2["Worker 2"]
        W3["Worker 3"]
    end

    subgraph Out["04 Results &amp; Trays"]
        direction LR
        Done["Done Tray<br/>Result{Err: nil}"]
        Backoff["Retry Backoff<br/>Wait + Jitter → Producer"]
        Failed["Failed Tray (DLQ)<br/>All 3 attempts used"]
    end

    P -- "2. Buffered send (workers Busy)" --> Tail
    P -. "3. Blocked send (Buffer FULL = Backpressure)" .-> Tail
    P -- "1. Handoff (skips buffer if worker Idle)" --> Pool
    Front -- "Receive (&lt;-jobs)" --> Pool
    Pool -- "Finishes in time" --> Done
    Pool -- "Timeout / HTTP 503 (Attempt 1–2)" --> Backoff
    Pool -- "Attempt 3 fails" --> Failed`,
	},
	states: {
		defaultTitle: 'Worker goroutine state transitions',
		defaultCaption:
			'Each worker moves between five states. A worker is never Idle while the buffer holds a job: it stays Busy and takes the next job from Slot [0].',
		code: `stateDiagram-v2
    direction TB
    [*] --> Offline : Slot not started
    Offline --> Idle : go worker(id, jobs, results)
    Idle --> Busy : Receive a job
    Busy --> Idle : Buffer empty
    Busy --> Alert : Timeout or HTTP 503
    Alert --> Idle : Routed to Backoff or Failed
    Busy --> Draining : Pool size lowered
    Draining --> Offline : Current job finishes
    Idle --> Offline : close(jobs) and empty`,
	},
	resilience: {
		defaultTitle: 'Attempt deadline, retry backoff, and dead-letter queue',
		defaultCaption:
			'Each attempt gets its own context deadline. Transient failures wait in Retry backoff with jitter so retries do not block a worker or flood the downstream service.',
		code: `flowchart TB
    Start["Worker takes Job (Attempt 1..3)"] --> Ctx["context.WithTimeout(parent, limit)"]
    Ctx --> Select{"Finishes before ctx.Done()?"}
    Select -- "Yes (Err == nil)" --> Done["04 Done Tray<br/>results &lt;- Result{Err: nil}"]
    Select -- "Timeout or HTTP 503" --> Alert["03 Worker Alert<br/>Coral flash"]
    Alert --> Check{"Attempt &lt; 3?"}
    Check -- "Yes (Attempt 1 or 2)" --> Backoff["01 Retry Backoff Tray<br/>Exponential wait + Jitter"]
    Backoff -. "Re-send (r1/2 or r2/2)" .-> Start
    Check -- "No (Attempt 3 failed)" --> Failed["04 Failed Tray<br/>Dead-letter queue (DLQ)"]`,
	},
};

const item = diagrams[id];
const heading = title ?? item.defaultTitle;
const desc = caption ?? item.defaultCaption;
---

<figure class="mermaid-figure" data-diagram={id}>
	<div class="mermaid-head">
		<strong class="mermaid-title">{heading}</strong>
	</div>
	<div class="mermaid-canvas" data-mermaid-host>
		<pre class="mermaid-raw" data-mermaid-source={item.code}>{item.code}</pre>
	</div>
	<figcaption class="mermaid-foot">
		<p class="mermaid-caption">{desc}</p>
	</figcaption>
</figure>

<script>
	import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

	const upgradeMarkdownBlocks = () => {
		const prose = document.querySelector('[data-lesson-prose]');
		if (prose) {
			const blocks = prose.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]');
			blocks.forEach((pre) => {
				const raw = (pre.textContent ?? '').replace(/^\s*%%\s*diagram:.*$/gm, '').trim();
				const match = (pre.textContent ?? '').match(/%%\s*diagram:\s*(pipeline|states|resilience)/);
				const id = match?.[1];
				if (id) {
					const holder = document.querySelector<HTMLElement>(`[data-mermaid-tpl="${id}"]`);
					const fig = holder?.querySelector('.mermaid-figure');
					if (fig) {
						pre.replaceWith(fig);
						return;
					}
				}
				const fig = document.createElement('figure');
				fig.className = 'mermaid-figure';
				const canvas = document.createElement('div');
				canvas.className = 'mermaid-canvas';
				canvas.setAttribute('data-mermaid-host', '');
				const sourceEl = document.createElement('pre');
				sourceEl.className = 'mermaid-raw';
				sourceEl.setAttribute('data-mermaid-source', raw);
				sourceEl.textContent = raw;
				canvas.appendChild(sourceEl);
				fig.appendChild(canvas);
				pre.replaceWith(fig);
			});
		}
		document.querySelector('[data-mermaid-stash]')?.remove();
	};

	const getThemeConfig = () => {
		const style = getComputedStyle(document.documentElement);
		const token = (name: string) => style.getPropertyValue(name).trim();
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

		const bgPanel = token('--bg-panel');
		const bgStage = token('--bg-stage');
		const bgInset = token('--bg-inset');
		const bgChannel = token('--bg-channel');
		const ink = token('--ink');
		const inkMuted = token('--ink-muted');
		const line = token('--line');
		const lineStrong = token('--line-strong');
		const goBlue = token('--go-blue');
		const fontSans = token('--font-sans');

		return {
			startOnLoad: false,
			securityLevel: 'loose',
			theme: 'base',
			fontFamily: fontSans,
			flowchart: {
				htmlLabels: true,
				curve: 'basis',
				padding: 14,
				nodeSpacing: 28,
				rankSpacing: 38,
				useMaxWidth: true,
			},
			state: {
				useMaxWidth: true,
			},
			themeVariables: {
				darkMode: isDark,
				background: bgStage,
				primaryColor: bgPanel,
				primaryTextColor: ink,
				primaryBorderColor: goBlue,
				secondaryColor: bgChannel,
				secondaryTextColor: ink,
				secondaryBorderColor: lineStrong,
				tertiaryColor: bgInset,
				tertiaryTextColor: ink,
				tertiaryBorderColor: line,
				lineColor: lineStrong,
				textColor: ink,
				mainBkg: bgPanel,
				nodeBorder: goBlue,
				clusterBkg: bgInset,
				clusterBorder: line,
				titleColor: ink,
				edgeLabelBackground: bgPanel,
				stateBkg: bgPanel,
				stateLabelColor: ink,
				labelColor: ink,
				altBackground: bgInset,
				fontSize: '13px',
			},
		};
	};

	let renderCount = 0;

	const renderAllDiagrams = async () => {
		mermaid.initialize(getThemeConfig());
		const hosts = document.querySelectorAll<HTMLElement>('[data-mermaid-host]');
		for (const host of hosts) {
			const rawEl = host.querySelector<HTMLElement>('[data-mermaid-source]');
			const source = host.getAttribute('data-saved-source') ?? rawEl?.getAttribute('data-mermaid-source') ?? '';
			if (!source) continue;
			host.setAttribute('data-saved-source', source);
			try {
				renderCount += 1;
				const svgId = `mermaid-svg-${renderCount}`;
				const { svg } = await mermaid.render(svgId, source);
				host.innerHTML = svg;
				const svgEl = host.querySelector('svg');
				if (svgEl) {
					svgEl.classList.add('mermaid-svg');
					svgEl.removeAttribute('height');
				}
			} catch (err) {
				console.error('Mermaid render error:', err);
			}
		}
	};

	upgradeMarkdownBlocks();
	renderAllDiagrams();

	const observer = new MutationObserver((mutations) => {
		for (const m of mutations) {
			if (m.type === 'attributes' && m.attributeName === 'data-theme') {
				renderAllDiagrams();
				break;
			}
		}
	});
	observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
